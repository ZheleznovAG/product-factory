{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent_outputs",
  "description": "Structured outputs from agent: spec, plan, task graph. All agent-generated artifacts must validate against one of these.",
  "oneOf": [
    { "$ref": "#/$defs/product_spec" },
    { "$ref": "#/$defs/execution_plan" },
    { "$ref": "#/$defs/task_graph" },
    { "$ref": "#/$defs/pipeline_plan" },
    { "$ref": "#/$defs/adr_draft" },
    { "$ref": "#/$defs/test_plan" }
  ],
  "$defs": {
    "product_spec": {
      "type": "object",
      "description": "PRD / high-level spec for the product",
      "properties": {
        "type": { "const": "product_spec" },
        "goal": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      },
      "required": ["type", "goal", "summary"]
    },
    "execution_plan": {
      "type": "object",
      "description": "Plan of steps to produce the product",
      "properties": {
        "type": { "const": "execution_plan" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "tool": { "type": "string" },
              "inputs": { "type": "object" },
              "depends_on": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "description"]
          }
        }
      },
      "required": ["type", "steps"]
    },
    "task_graph": {
      "type": "object",
      "description": "Task graph for workflow execution",
      "properties": {
        "type": { "const": "task_graph" },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "tool_call": {
                "type": "object",
                "properties": {
                  "tool": { "type": "string" },
                  "arguments": { "type": "object" }
                }
              },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["id", "name"]
          }
        }
      },
      "required": ["type", "tasks"]
    },
    "pipeline_plan": {
      "type": "object",
      "description": "Pipeline steps generated by the agent planner",
      "properties": {
        "type": { "const": "pipeline_plan" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "tool": { "type": "string" },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["id", "description", "tool", "depends_on"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "steps"],
      "additionalProperties": false
    },
    "adr_draft": {
      "type": "object",
      "description": "Draft ADR generated by the agent planner",
      "properties": {
        "type": { "const": "adr_draft" },
        "context": { "type": "string" },
        "decision": { "type": "string" },
        "consequences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "required": ["type", "context", "decision", "consequences"],
      "additionalProperties": false
    },
    "test_plan": {
      "type": "object",
      "description": "Planner-generated test plan for the workflow run",
      "properties": {
        "type": { "const": "test_plan" },
        "scope": { "type": "string" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "type": { "type": "string" }
            },
            "required": ["id", "description", "type"],
            "additionalProperties": false
          }
        },
        "coverage_targets": {
          "type": "object",
          "properties": {
            "unit_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "integration_required": { "type": "boolean" },
            "security_required": { "type": "boolean" }
          },
          "required": ["unit_percent", "integration_required", "security_required"],
          "additionalProperties": false
        }
      },
      "required": ["type", "scope", "cases", "coverage_targets"],
      "additionalProperties": false
    }
  }
}
