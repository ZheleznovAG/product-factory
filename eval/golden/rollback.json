{
  "id": "rollback",
  "description": "Rollback flow when apply_patch fails after repository scaffold",
  "input": {
    "run_id": "golden-rollback",
    "goal": "Build catalog API and apply generated patch",
    "constraints": [
      "ktor"
    ],
    "target_stack": "catalog-service",
    "policy": {
      "allow": true,
      "require_human_approval": false
    },
    "inject_codegen_patch": true,
    "simulate_rollback_on_patch_failure": true
  },
  "expected": {
    "status": "rejected",
    "message_contains": "Tool call failed",
    "state_sequence": [
      "PLANNED",
      "FAILED"
    ],
    "required_event_types": [
      "tool_call_executed",
      "rollback_executed",
      "state_changed"
    ],
    "forbidden_event_types": [
      "artifact_registry_updated"
    ],
    "expected_tool_calls": [
      {
        "tool_name": "create_repo_from_archetype",
        "archetype_id": "catalog-service"
      },
      {
        "tool_name": "apply_patch"
      }
    ]
  }
}
