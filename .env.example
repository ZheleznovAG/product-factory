# Product Factory — пример переменных окружения (скопировать в .env, не коммитить .env)

# === Нейросервис (опционально) ===
# Базовый URL сервиса с OpenAI-совместимым /v1/chat/completions.
# Варианты: https://api.openai.com, http://localhost:8090 (gateway на хосте), URL self-hosted.
# NEURAL_SERVICE_URL=http://localhost:8090
# NEURAL_SERVICE_API_KEY=

# === Gateway на хосте (scripts/neural_gateway) ===
# NEURAL_BACKEND=codex|openai|proxy
# CODEX_PATH=codex
# OPENAI_API_KEY=
# PROXY_TARGET_URL=

# === Фабрика (Docker/локально) ===
# Compose: фабрика 9080, Grafana 3001, Prometheus 9090 (фиксировано, без переменных).
# Профиль окружения: local (по умолчанию), ci, k8s. Пишется в audit при run; в CI/K8s рекомендуется POLICY_FAIL_MODE=closed.
# FACTORY_ENV=local
# Профиль AuthN API (H1-Auth-1.1): OIDC Bearer JWT.
# AUTH_MODE=oidc_jwt
# Ожидаемый issuer access token (iss).
# AUTH_JWT_ISSUER=https://iam.example.com/realms/product-factory
# Ожидаемый audience access token (aud).
# AUTH_JWT_AUDIENCE=product-factory-api
# Mapping claims -> runtime identity fields.
# AUTH_JWT_CLAIM_TENANT_ID=tenant_id
# AUTH_JWT_CLAIM_SUBJECT=sub
# AUTH_JWT_CLAIM_ROLES=roles
# roles claim поддерживает строку или массив строк.
# Секрет для HS256-подписи JWT (локально/тесты).
# AUTH_JWT_HS256_SECRET=change-me
# AUDIT_LOG_PATH=audit.log
# APPROVALS_DIR=approvals
# PERIOD_USAGE_STORE_PATH=data/period-usage-counters.json
# OPA_URL=
# Режим при недоступности OPA: open = разрешить run (fallback allow), closed = запретить. По умолчанию open.
# POLICY_FAIL_MODE=open
# Durable workflow (WS0): при заданном TEMPORAL_ADDRESS фабрика поднимает Temporal Worker и выполняет run через Temporal (persist, retry по шагам). POST /factory/run возвращает 202 и status=started; результат — по GET /factory/runs/{runId} после завершения.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# Путь к реестру tools (single source of truth). По умолчанию contracts/tools.registry.json (относительно CWD).
# FACTORY_TOOLS_REGISTRY_PATH=contracts/tools.registry.json
# Режим выполнения tools: sandbox (по умолчанию) или docker. При docker — create_repo_from_archetype и apply_patch в контейнере (образ DOCKER_IMAGE_TOOL_RUNNER).
# FACTORY_TOOL_RUNNER=sandbox
# Образ для изолированного выполнения tools (используется при FACTORY_TOOL_RUNNER=docker). Сборка: docker build -f deploy/Dockerfile.tool-runner -t product-factory-tool-runner .
# DOCKER_IMAGE_TOOL_RUNNER=product-factory-tool-runner:latest
# Минимальный remote-ssh runner (включается только если заданы все три переменные).
# FACTORY_REMOTE_SSH_HOST=build-node.internal
# FACTORY_REMOTE_SSH_USER=deployer
# FACTORY_REMOTE_SSH_KEY_PATH=/run/secrets/pf_deployer_key
# Таймаут вызова LLM в планировщике (сек). По умолчанию 120 — для Codex CLI 30 с мало.
# PLANNER_LLM_TIMEOUT_SECONDS=120
# Таймаут вызова LLM в кодогене (сек). По умолчанию 120.
# CODEGEN_LLM_TIMEOUT_SECONDS=120
# Опциональный RAG-контекст для LLM-планировщика (только read-path из pgvector).
# RAG_PLANNER_CONTEXT_ENABLED=false
# RAG_PLANNER_TOP_K=6
# RAG_PGVECTOR_JDBC_URL=jdbc:postgresql://localhost:5432/product_factory
# RAG_PGVECTOR_DB_USER=postgres
# RAG_PGVECTOR_DB_PASSWORD=postgres
# RAG_INDEX_NAMESPACE=factory-main
# RAG_INDEX_SOURCE_DIRS=archetypes,docs
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_DIM=1536
# RAG_CHUNK_SIZE=1200
# RAG_CHUNK_OVERLAP=150

# === Хранилище профиля предпочтений (embedding + rules) ===
# По умолчанию выключено. При включении добавляются API:
# PUT/GET/DELETE /factory/profiles/{profileId}
# PROFILE_STORE_ENABLED=true
# PROFILE_STORE_DIR=profiles
# Требовать явное согласие consent.profileStorage=true при записи профиля.
# PROFILE_REQUIRE_CONSENT=true
# Ожидаемая длина embedding-вектора (если embedding передан в API).
# PROFILE_EMBEDDING_DIM=1536
# Ограничение числа правил в профиле.
# PROFILE_MAX_RULES=64

# === GitHub (опционально) ===
# Если заданы, фабрика создаёт репо на GitHub и пушит туда код после каждого run.
# Токен: GitHub → Settings → Developer settings → Personal access tokens → Generate (scope: repo).
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Владелец репо: ваш логин или организация. Пусто = репо под пользователем токена.
# GITHUB_OWNER=my-username

# === Артефакты в S3/MinIO (опционально) ===
# Если задан ARTIFACT_STORAGE_BUCKET, после создания репо фабрика загружает ZIP в хранилище.
# ARTIFACT_STORAGE_BUCKET=artifacts
# ARTIFACT_STORAGE_PREFIX=artifacts
# ARTIFACT_STORAGE_ENDPOINT=http://minio:9000
# ARTIFACT_STORAGE_ACCESS_KEY=
# ARTIFACT_STORAGE_SECRET_KEY=
# ARTIFACT_STORAGE_REGION=us-east-1

# === Источник sbomVersion/signatureVersion для run record (опционально) ===
# Приоритет в рантайме: tool result -> CI env -> файлы в workspace; если ничего нет, остаётся placeholder.
# CI-инъекция «готовых» идентификаторов:
# FACTORY_SBOM_VERSION=sbom:cyclonedx:ghcr.io/org/image@sha256:...
# FACTORY_SIGNATURE_VERSION=signature:cosign:ghcr.io/org/image@sha256:...
# Явные пути к post-step артефактам внутри repo workspace/pf-<runId>/ (относительно директории репо):
# FACTORY_SBOM_PATH=build/sbom-cyclonedx.json
# FACTORY_SIGNATURE_PATH=build/cosign.bundle.json
