# direnv: загрузка переменных из env.d (один файл = одна переменная).
# Экспортируем только файлы с допустимым именем переменной (буквы, цифры, _); пропускаем .example, .md, .gitkeep.
# После правок: direnv allow
for f in env.d/*; do
  if [[ -f "$f" ]]; then
    name=$(basename "$f")
    [[ "$name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && export "$name=$(cat "$f" | tr -d '\n')"
  fi
done
